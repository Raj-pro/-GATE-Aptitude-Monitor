# GATE Aptitude Monitor - Environment Variables Example Template
# Copy this file to .env and fill in your actual values.

# 1. Google Spreadsheet ID
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# 2. Google Apps Script Web App URL (Direct Sync - Recommended)
GOOGLE_WEBAPP_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# 3. Google OAuth 2.0 Client ID (If using Google OAuth Sign-In Popup)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# 4. YouTube Playlist ID
YOUTUBE_PLAYLIST_ID=PLC36xJgs4dxE43Au1FGRQvwHTr7NbgDCS
